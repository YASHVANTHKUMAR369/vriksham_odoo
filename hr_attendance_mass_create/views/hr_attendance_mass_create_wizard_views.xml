<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_attendance_mass_create_wizard_form" model="ir.ui.view">
        <field name="name">hr.attendance.mass.create.wizard.form</field>
        <field name="model">hr.attendance.mass.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Mass Create Attendances">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="checkin_time" widget="float_time"/>
                        <field name="checkout_time" widget="float_time"/>
                    </group>
                    <group>
                        <field name="saturday"/>
                        <field name="sunday"/>
                        <field name="no_attendance_create_employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_attendance" string="Create" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_attendance_mass_create_wizard" model="ir.actions.act_window">
        <field name="name">Mass Create Attendances</field>
        <field name="res_model">hr.attendance.mass.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_hr_attendance_mass_create_wizard_form"/>
    </record>

    <menuitem
        id="menu_hr_attendance_mass_create_wizard"
        name="Mass Create Attendances"
        parent="hr_attendance.menu_hr_attendance_root"
        action="action_hr_attendance_mass_create_wizard"
        sequence="90"
        groups="hr_attendance.group_hr_attendance_user"
    />
</odoo>
