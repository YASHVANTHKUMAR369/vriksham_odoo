<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!-- Sees every app, nothing is hidden. -->
    <record id="menu_role_admin" model="res.users.menu.role">
        <field name="name">Admin</field>
        <field name="sequence">10</field>
        <field name="show_all_menus">1</field>
    </record>

    <!-- Configure "Allowed Menus (Apps)" below with the HR-related apps
         (Employees, Recruitment, Time Off, Attendances, ...). Every other
         app is hidden automatically for users assigned this role. -->
    <record id="menu_role_hr" model="res.users.menu.role">
        <field name="name">HR</field>
        <field name="sequence">20</field>
    </record>

    <!-- Configure "Allowed Menus (Apps)" below with the self-service apps
         (Time Off, Attendances, Expenses, ...). Every other app is hidden
         automatically for users assigned this role. This is the default
         role for newly created users. -->
    <record id="menu_role_employee" model="res.users.menu.role">
        <field name="name">Employee</field>
        <field name="sequence">30</field>
    </record>
</odoo>
