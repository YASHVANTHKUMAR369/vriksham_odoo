<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Template for Payslip Details Report-->
    <template id="hr_payroll_community.report_payslipdetails">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family:'Helvetica Neue', Helvetica, Arial, sans-serif; font-size:12px; color:#111827; line-height:1.35; text-transform:uppercase;">
                        <div class="text-center" style="margin-bottom:10px;">
                            <h3 style="font-size:20px; margin:0; font-weight:700; letter-spacing:0.2px;">PAY SLIP</h3>
                        </div>
<!--                        <p t-field="o.name"/>-->
                        <table class="table table-sm table-bordered" style="width:100%; border-collapse:collapse; table-layout:fixed; margin-bottom:14px; border-bottom:2px solid #111827;">
                            <colgroup>
                                <col style="width:20%;"/>
                                <col style="width:30%;"/>
                                <col style="width:20%;"/>
                                <col style="width:30%;"/>
                            </colgroup>
                            <tr>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; font-weight:600; text-align:left;">
                                    <strong>NAME</strong>
                                </td>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; text-align:left;">
                                    <span t-field="o.employee_id"/>
                                </td>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; font-weight:600; text-align:left;">
                                    <strong>DESIGNATION</strong>
                                </td>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; text-align:left;">
                                    <span t-field="o.employee_id.job_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; font-weight:600; text-align:left;">
                                    <strong>EMAIL</strong>
                                </td>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; text-align:left; word-break:break-word;">
                                    <span t-field="o.employee_id.work_email"/>
                                </td>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; font-weight:600; text-align:left;">
                                    <strong>IDENTIFICATION NO</strong>
                                </td>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; text-align:left;">
                                    <span t-field="o.employee_id.identification_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; font-weight:600; text-align:left;">
                                    <strong>REFERENCE</strong>
                                </td>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; text-align:left;">
                                    <span t-field="o.number"/>
                                </td>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; font-weight:600; text-align:left;">
                                    <strong>BANK ACCOUNT</strong>
                                </td>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; text-align:left;">
                                    <span t-field="o.employee_id.bank_account_ids"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; font-weight:600; text-align:left;">
                                    <strong>DATE FROM</strong>
                                </td>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; text-align:left;">
                                    <span t-field="o.date_from"/>
                                </td>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; font-weight:600; text-align:left;">
                                    <strong>DATE TO</strong>
                                </td>
                                <td style="padding:6px 8px; border:1px solid #9ca3af; text-align:left;">
                                    <span t-field="o.date_to"/>
                                </td>
                            </tr>
                        </table>
                        <h3 style="font-size:15px; margin:0 0 8px 0; font-weight:700; text-align:left;">DETAILS BY SALARY RULE CATEGORY</h3>
                        <t t-raw="o.payslip_calculation_html"/>
                        <div style="margin-top: 24px;">
                            <p>
                                <strong>
                                    For <span class="ms-1" t-esc="o.emp_company"/>,
                                </strong>
                            </p>

                            <img t-if="o.company_id and o.company_id.hr_signature"
                                 t-att-src="image_data_uri(o.company_id.hr_signature)"
                                 style="max-height:130px; margin-left:20px"/>

                            <p>
                                <strong>
                                    <t t-esc="o.emp_hr_name"/>
                                    <br/>HR Head
                                </strong>
                            </p>
                        </div>
                        
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
