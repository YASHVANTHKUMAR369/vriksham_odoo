<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_payslip_run_view_form_inherit_hrms_changes" model="ir.ui.view">
        <field name="name">hr.payslip.run.view.form.inherit.hrms.changes</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payslip_run_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='close_payslip_run']" position="after">
                <button name="action_confirm_batch_payslips"
                        type="object"
                        string="Confirm Payslips"
                        class="oe_highlight"
                        invisible="state != 'draft'"/>
                <button name="action_create_batch_journal_entries"
                        type="object"
                        string="Create Journal Entry"
                        class="btn-secondary"
                        invisible="state != 'confirmed'"
                        groups="account.group_account_manager,account.group_account_user"/>
                <button name="action_send_batch_payslip_mail"
                        type="object"
                        string="Send Mail"
                        class="btn-secondary"
                        invisible="state != 'journal'"/>
            </xpath>

            <xpath expr="//button[@name='close_payslip_run']" position="attributes">
                <attribute name="invisible">state == 'close'</attribute>
            </xpath>

            <xpath expr="//header/button[@type='action']" position="attributes">
                <attribute name="invisible">state != 'draft'</attribute>
            </xpath>

            <xpath expr="//button[@name='action_payslip_run']" position="attributes">
                <attribute name="invisible">state != 'close'</attribute>
            </xpath>

            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,confirmed,journal,mail_sent,close</attribute>
            </xpath>

            <xpath expr="//field[@name='credit_note']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
