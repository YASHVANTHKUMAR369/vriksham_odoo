<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_payslip_journal_entry_wizard_form" model="ir.ui.view">
        <field name="name">hr.payslip.journal.entry.wizard.form</field>
        <field name="model">hr.payslip.journal.entry.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Journal Entry">
                <group>
                    <field name="company_id"/>
                    <field name="bank_journal_id"/>
                    <field name="payment_method_line_id"/>
                    <field name="payment_date"/>
                    <field name="ref"/>
                </group>
                <footer>
                    <button name="action_create_entries" string="Create Entry" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_payslip_journal_entry_wizard" model="ir.actions.act_window">
        <field name="name">Create Journal Entry</field>
        <field name="res_model">hr.payslip.journal.entry.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
