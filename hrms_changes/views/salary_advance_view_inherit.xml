<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="salary_advance_view_form_inherit_paid" model="ir.ui.view">
        <field name="name">salary.advance.form.inherit.paid</field>
        <field name="model">salary.advance</field>
        <field name="inherit_id" ref="ohrms_salary_advance.salary_advance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='approve_request_acc_dept']" position="after">
                <button name="action_create_journal_entry"
                        string="Create Journal Entry"
                        type="object"
                        invisible="state not in ('waiting_approval')"
                        class="btn-secondary"
                        groups="account.group_account_manager,account.group_account_user"/>
            </xpath>
            <xpath expr="//field[@name='exceed_condition']" position="after">
                <field name="paid" readonly="1" force_save="1"/>
            </xpath>
        </field>
    </record>

    <record id="salary_advance_action_create_journal_entry_multi" model="ir.actions.server">
        <field name="name">Create Journal Entry</field>
        <field name="model_id" ref="ohrms_salary_advance.model_salary_advance"/>
        <field name="binding_model_id" ref="ohrms_salary_advance.model_salary_advance"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_create_journal_entry()</field>
    </record>
</odoo>