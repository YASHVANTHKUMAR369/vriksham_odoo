<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="hr_payslip_view_tree_inherit_salary" model="ir.ui.view">
        <field name="name">hr.payslip.tree.inherit.salary</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payslip_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_to']" position="after">
                <field name="gross_salary"/>
                <field name="net_salary"/>
            </xpath>
        </field>
    </record>

    <record id="hr_payslip_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.kanban.contract.info</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payslip_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <widget name="web_ribbon"
                        title="Paid"
                        bg_color="bg-success"
                        invisible="state != 'done' or journal_entry_status != 'paid'"/>
                <widget name="web_ribbon"
                        title="Reversed"
                        bg_color="bg-danger"
                        invisible="state != 'done' or journal_entry_status != 'reversed'"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_journal_entry"
                        class="oe_stat_button"
                        icon="fa-book"
                        type="object"
                        invisible="not journal_entry_id"
                        groups="account.group_account_manager,account.group_account_user">
                    <field name="journal_entry_count" widget="statinfo" string="Journal Entry"/>
                </button>
                <button name="action_view_leaves"
                        class="oe_stat_button"
                        icon="fa-calendar-times-o"
                        type="object">
                    <field name="leave_count" widget="statinfo" string="Leaves"/>
                </button>
                <button name="action_view_attendances"
                        class="oe_stat_button"
                        icon="fa-clock-o"
                        type="object">
                    <field name="attendance_count" widget="statinfo" string="Attendances"/>
                </button>
            </xpath>

            <xpath expr="//button[@name='action_payslip_done']" position="after">
                <button string="Create Journal Entry"
                        name="action_create_journal_entry"
                        type="object"
                        invisible="state != 'done' or journal_entry_count &gt; 0"
                        class="btn-secondary"
                        groups="account.group_account_manager,account.group_account_user"/>
                <button string="Send Mail"
                    name="action_open_send_payslip_mail_wizard"
                    type="object"
                    invisible="state != 'done'"
                    class="btn-secondary"/>
            </xpath>

            <xpath expr="//button[@name='action_compute_sheet']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='action_refund_sheet']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[contains(@class, 'oe_stat_button') and .//field[@name='payslip_count']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='date_to']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <xpath expr="//field[@name='credit_note']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//sheet/group[.//field[@name='credit_note']]" position="after">
                <group col="4" colspan="4" name="payslip_custom_amounts_group">
                    <group colspan="2" col="2">
                        <field name="loan_ids" widget="many2many_tags" readonly="state == 'done'" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                        <field name="salary_advance_ids" widget="many2many_tags" readonly="state == 'done'" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                        <field name="journal_entry_id" readonly="1" options="{'no_create': True}"/>
                    </group>
                    <group colspan="2" col="2">
                        <field name="employee_pf" readonly="state != 'draft'"/>
                        <field name="professional_tax" readonly="state != 'draft'"/>
                        <field name="tds_amount" readonly="state != 'draft' or ((contract_id.employee_pf or 0.0) == 0.0 and (contract_id.professional_tax or 0.0) == 0.0)"/>
                        <field name="gross_salary"/>
                        <field name="net_salary"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='contract_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='struct_id']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute name="force_save">1</attribute>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook" position="replace">
                <notebook>
                    <page string="Worked Days &amp; Inputs">
                    <separator string="Other Inputs"/>
                                <field name="input_line_ids" colspan="4" nolabel="1" readonly="state != 'draft'" context="{'default_contract_id': contract_id}">
                                    <list string="Input Data" editable="bottom">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="amount"/>
                                        <field name="contract_id"/>
                                        <field name="sequence" coloum_invisible="True"/>
                                    </list>
                                    <form string="Payslip Line">
                                        <group col="4">
                                            <field name="name"/>
                                            <field name="code"/>
                                            <field name="sequence"/>
                                            <field name="amount"/>
                                            <field name="contract_id"/>
                                        </group>
                                    </form>
                                </field>
                        <separator string="Worked Days"/>
                        <group>
                            <field name="days_calculation" readonly="1" force_save="1"/>
                        </group>
                    </page>
                    <page string="Salary Calculation">
                        <group>
                            <field name="payslip_calculation_html" readonly="1"/>
                        </group>
                    </page>
                </notebook>
            </xpath>

            <xpath expr="//sheet" position="after">
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </xpath>
        </field>
    </record>

    <record id="hr_payslip_action_create_journal_entry_multi" model="ir.actions.server">
        <field name="name">Create Journal Entry</field>
        <field name="model_id" ref="hr_payroll_community.model_hr_payslip"/>
        <field name="binding_model_id" ref="hr_payroll_community.model_hr_payslip"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_create_journal_entry()</field>
    </record>
</odoo>