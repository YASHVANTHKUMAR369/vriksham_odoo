<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_menu_configurator_list" model="ir.ui.view">
        <field name="name">menu.configurator.list</field>
        <field name="model">menu.configurator</field>
        <field name="arch" type="xml">
            <list string="Menu Configurator">
                <field name="sequence" widget="handle"/>
                <field name="icon" widget="image" options="{'size': [32, 32]}"/>
                <field name="name"/>
                <field name="parent_id" optional="show"/>
                <field name="action_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_menu_configurator_form" model="ir.ui.view">
        <field name="name">menu.configurator.form</field>
        <field name="model">menu.configurator</field>
        <field name="arch" type="xml">
            <form string="Menu Configurator">
                <sheet>
                    <field name="icon" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Tile label, e.g. Customers"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id" placeholder="Top level (shown in the app grid)"/>
                            <field name="action_id"
                                   placeholder="Leave empty if this tile only groups child tiles"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Child Tiles" name="child_tiles">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="icon" widget="image" options="{'size': [32, 32]}"/>
                                    <field name="name"/>
                                    <field name="action_id"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_menu_configurator_search" model="ir.ui.view">
        <field name="name">menu.configurator.search</field>
        <field name="model">menu.configurator</field>
        <field name="arch" type="xml">
            <search string="Menu Configurator">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="action_id"/>
                <filter name="root_only" string="Top Level" domain="[('parent_id', '=', False)]"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_parent" string="Parent Menu" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_menu_configurator" model="ir.actions.act_window">
        <field name="name">Configure Menus</field>
        <field name="res_model">menu.configurator</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_root_only': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a menu tile
            </p>
            <p>
                Pick an action, give it a name and an icon, and it will show
                up in the App Grid and in the main Apps menu. Nest tiles
                under a parent to build folders. Untick "Active" to hide a
                tile without deleting it.
            </p>
        </field>
    </record>

    <record id="action_menu_configurator_grid" model="ir.actions.client">
        <field name="name">App Grid</field>
        <field name="tag">menu_configurator_grid</field>
    </record>

    <menuitem id="menu_configurator_root"
              name="Menu Configurator"
              sequence="95"
              web_icon="menu_configurator,static/description/icon.png"/>

    <menuitem id="menu_configurator_grid_menu"
              name="App Grid"
              parent="menu_configurator_root"
              action="action_menu_configurator_grid"
              sequence="1"/>

    <menuitem id="menu_configurator_config_menu"
              name="Configuration"
              parent="menu_configurator_root"
              action="action_menu_configurator"
              groups="base.group_system"
              sequence="10"/>
</odoo>
